<%= turbo_frame_tag cat do %>
  <%= bootstrap_form_with( model: cat,
                          html: { novalidate: true },
        data: { action: "turbo:submit-end->modal#close" }
      ) do |form| %>
       <%= form.text_field :name %> 
       <%= form.text_field :age %>
       <%= form.primary  %>
  <% end %>
<% end %>
